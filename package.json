{
  "name": "observer-protocol",
  "version": "0.1.0",
  "description": "Analyze recent Markdown vault records for recurrences and unchecked actions. Capture intake in Markdown; human review workflows require approval integration.",
  "main": "dist/cli.js",
  "bin": {
    "observer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "server": "ts-node src/server.ts",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "keywords": [
    "agent-governance",
    "human-in-the-loop",
    "markdown",
    "context-engineering",
    "typescript",
    "developer-tools"
  ],
  "author": "Victor Valentine Romo <victor@scalewithsearch.com> (https://victorvalentineromo.com)",
  "homepage": "https://github.com/b2bvic/observer-protocol",
  "repository": {
    "type": "git",
    "url": "https://github.com/b2bvic/observer-protocol.git"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "node-cron": "^4.6.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
